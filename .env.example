# Copy this file to .env and fill it in. .env is git-ignored; never commit it.

# --- Content API (server/index.mjs) ---------------------------------
PORT=4000

# Password for the /#/admin panel.
# Leave unset and the server mints a random one each boot and prints it.
# Set your own to keep it stable. Use something long.
ADMIN_PASSWORD=

# Origins allowed to call the API (comma separated).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173

# --- Frontend (vite) ------------------------------------------------
# Where the website looks for the API.
# Local development: http://localhost:4000
# Production static deploy: leave UNSET — the site reads public/content.json.
VITE_API_URL=http://localhost:4000
